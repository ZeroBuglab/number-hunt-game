import random

level = input("Choose level: 1-Easy, 2-Normal, 3-Hard: ")
if level == "1":
    start, end = 1, 10
elif level == "2":
    start, end = 1, 100
else:
    start, end = 1, 1000
number = random.randint(start, end)
attempts = 5
while attempts > 0:
    you = int(input("Your Number: "))
    if you == number:
        print("You Won!")
        break
    elif you > number:
        print("your num very big")
    else:
        print("your num very small")
    attempts -= 1
    print("Your attempts:", attempts)
    if attempts == 0:
        print("You Lose! The number was:", number)
        break
    stop = input("Do you want to continue? (yes/no): ")
    if stop == "no":
        break
